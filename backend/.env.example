# SkyWork Backend Production Environment Variables

# Server Port & Environment
PORT=5000
NODE_ENV=production

# Security & JWT Token Key
JWT_SECRET=SkyWork_secure_jwt_token_secret_key_2026

# Default Admin Credentials
ADMIN_USER=admin
ADMIN_PASS=123456

# Base User Web App URL
APP_URL=https://skywork.us.cc

# Dedicated MySQL Database Configuration (aaPanel)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=skywork
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=skywork

# Firebase Cloud Messaging (Push Notifications ONLY - No Firestore DB)
# Paste service account JSON or drop file in src/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT={"type": "service_account", ...}
